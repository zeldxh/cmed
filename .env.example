# Copia este archivo como ".env" y ajusta los valores para tu entorno local.
# El archivo ".env" no se sube al repositorio (ver .gitignore).
#
# Importante: Spring Boot no carga archivos .env automaticamente. Estas variables
# deben quedar disponibles como variables de entorno del proceso antes de ejecutar
# la aplicacion. Ver instrucciones en el README ("Variables de entorno").

# Conexion a MySQL. Si no se definen, la aplicacion usa los valores de desarrollo
# local ya definidos en application.properties (localhost:3306/citamed_db).
DB_URL=jdbc:mysql://localhost:3306/citamed_db
DB_USERNAME=usuario_citamed
DB_PASSWORD=la_Clave

# Credenciales SMTP para el envio de notificaciones por correo (Spring Mail).
# Si se dejan vacias, la aplicacion sigue funcionando: cada notificacion queda
# registrada en la tabla "notificacion" con exito = false.
MAIL_USERNAME=
MAIL_PASSWORD=
